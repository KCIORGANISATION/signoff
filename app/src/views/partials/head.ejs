<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title ? `${title} · Signoff` : 'Signoff' %></title>
  <meta name="robots" content="noindex">
  <meta name="theme-color" content="#1c0b33">
  <link rel="preload" href="/fonts/jakarta/plus-jakarta-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/jakarta/plus-jakarta-sans-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body class="<%= locals.bodyClass || '' %>">
<a class="skip-link" href="#main"><%= t('nav.skip') %></a>
<header class="site-header">
  <% if (locals.client || !currentUser) { %>
    <span class="brand"><span class="brand-mark"><%- include('icon', { name: 'check' }) %></span>Signoff</span>
  <% } else { %>
    <a class="brand" href="/dashboard"><span class="brand-mark"><%- include('icon', { name: 'check' }) %></span>Signoff</a>
  <% } %>
  <div class="header-nav">
    <% if (locals.crumbs && crumbs.length > 0) { %>
      <nav class="breadcrumb" aria-label="<%= t('nav.breadcrumb') %>">
        <% crumbs.forEach((c, i) => { %>
          <% if (i > 0) { %><span class="sep" aria-hidden="true">·</span><% } %>
          <% if (c.href) { %><a href="<%= c.href %>"><%= c.label %></a><% } else { %><span aria-current="page"><%= c.label %></span><% } %>
        <% }) %>
      </nav>
    <% } %>
    <% if (locals.projectLabel) { %><span class="muted"><%= projectLabel %></span><% } %>
    <% if (locals.positionLabel) { %><span class="pill"><%= positionLabel %></span><% } %>
    <% if (!locals.client && currentUser) { %>
      <a href="/dashboard" <%- currentPath === '/dashboard' ? 'aria-current="page"' : '' %>><%= t('nav.dashboard') %></a>
      <form class="inline" method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button" type="submit" style="text-decoration: none; padding: 0 8px;"><%= t('nav.logout') %></button></form>
    <% } %>
    <span class="lang" role="group" aria-label="<%= t('nav.language') %>">
      <a href="/lang/fr?back=<%= encodeURIComponent(currentPath) %>" aria-current="<%= lang === 'fr' %>" lang="fr">FR</a>
      <span aria-hidden="true">·</span>
      <a href="/lang/en?back=<%= encodeURIComponent(currentPath) %>" aria-current="<%= lang === 'en' %>" lang="en">EN</a>
    </span>
  </div>
</header>
<main id="main" class="page <%= locals.mainClass || '' %>" tabindex="-1">
