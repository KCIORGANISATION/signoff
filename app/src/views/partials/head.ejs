<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= locals.meta ? meta.title : title ? `${title} · Signoff` : 'Signoff' %></title>
  <% if (locals.meta) { %>
  <meta name="description" content="<%= meta.description %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Signoff">
  <meta property="og:title" content="<%= meta.title %>">
  <meta property="og:description" content="<%= meta.description %>">
  <meta property="og:url" content="<%= meta.url %>">
  <meta property="og:locale" content="<%= lang === 'fr' ? 'fr_BE' : 'en_GB' %>">
  <link rel="canonical" href="<%= meta.url %>">
  <% } else { %>
  <meta name="robots" content="noindex">
  <% } %>
  <meta name="theme-color" content="#1c0b33">
  <link rel="preload" href="/fonts/jakarta/plus-jakarta-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/jakarta/plus-jakarta-sans-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body class="<%= locals.bodyClass || '' %>">
<a class="skip-link" href="#main"><%= t('nav.skip') %></a>
<header class="site-header">
  <% if (!locals.client && !currentUser) { %>
    <a class="brand" href="/" <%- currentPath === '/' ? 'aria-current="page"' : '' %>><span class="brand-mark"><%- include('icon', { name: 'check' }) %></span>Signoff</a>
  <% } else if (locals.client) { %>
    <span class="brand"><span class="brand-mark"><%- include('icon', { name: 'check' }) %></span>Signoff</span>
  <% } else { %>
    <a class="brand" href="/dashboard"><span class="brand-mark"><%- include('icon', { name: 'check' }) %></span>Signoff</a>
  <% } %>
  <div class="header-nav">
    <% if (locals.crumbs && crumbs.length > 0) { %>
      <nav class="breadcrumb" aria-label="<%= t('nav.breadcrumb') %>">
        <% crumbs.forEach((c, i) => { %>
          <% if (i > 0) { %><span class="sep" aria-hidden="true">·</span><% } %>
          <% if (c.href) { %><a href="<%= c.href %>"><%= c.label %></a><% } else { %><span aria-current="page"><%= c.label %></span><% } %>
        <% }) %>
      </nav>
    <% } %>
    <% if (locals.projectLabel) { %><span class="muted"><%= projectLabel %></span><% } %>
    <% if (locals.positionLabel) { %><span class="pill"><%= positionLabel %></span><% } %>
    <% if (!locals.client && currentUser) { %>
      <a class="account-name" href="/profile" <%- currentPath.startsWith('/profile') ? 'aria-current="page"' : '' %> aria-label="<%= t('profile.link', { name: currentUser.name }) %>"><%- include('icon', { name: 'user' }) %><span><%= currentUser.name %></span></a>
      <form class="inline" method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="link-button" type="submit" style="text-decoration: none; padding: 0 8px;"><%= t('nav.logout') %></button></form>
    <% } %>
    <span class="lang" role="group" aria-label="<%= t('nav.language') %>">
      <a href="/lang/fr?back=<%= encodeURIComponent(currentPath) %>" aria-current="<%= lang === 'fr' %>" lang="fr">FR</a>
      <span aria-hidden="true">·</span>
      <a href="/lang/en?back=<%= encodeURIComponent(currentPath) %>" aria-current="<%= lang === 'en' %>" lang="en">EN</a>
    </span>
    <% if (locals.headerLogin) { %><a class="btn btn-small header-login" href="/login"><%= t('home.login') %></a><% } %>
  </div>
</header>
<% if (!locals.client && currentUser) { %>
  <% const tab = currentPath.startsWith('/dashboard') ? 'home' : /^\/(projects|milestones)(\/|\?|$)/.test(currentPath) ? 'projects' : /^\/stats(\/|\?|$)/.test(currentPath) ? 'stats' : null; %>
  <nav class="app-tabs" aria-label="<%= t('nav.tabs') %>">
    <div class="app-tabs-track">
      <a href="/dashboard" <%- tab === 'home' ? 'aria-current="page"' : '' %>><%- include('icon', { name: 'home' }) %><%= t('nav.home') %></a>
      <a href="/projects" <%- tab === 'projects' ? 'aria-current="page"' : '' %>><%- include('icon', { name: 'folder' }) %><%= t('nav.projects') %></a>
      <a href="/stats" <%- tab === 'stats' ? 'aria-current="page"' : '' %>><%- include('icon', { name: 'chart' }) %><%= t('nav.stats') %></a>
    </div>
  </nav>
<% } %>
<main id="main" class="page <%= locals.mainClass || '' %>" tabindex="-1">
