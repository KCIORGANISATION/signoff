<%# Presentation video. Until the video files exist, only this empty frame is shown.
    How to add the video (self-hosted, no cookie, no tracker): see "Vidéo de présentation" in the README. %>
<div class="video-frame glass rv" role="img" aria-label="<%= t('home.video.label') %>">
  <span class="video-play" aria-hidden="true"><svg viewBox="0 0 24 24" width="38" height="38"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg></span>
  <span class="video-tag video-tag-left" aria-hidden="true"><%= t('home.video.soon') %></span>
  <span class="video-tag video-tag-right" aria-hidden="true"><%= t('home.video.langs') %></span>
</div>
