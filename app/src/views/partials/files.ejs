<%# Files of a milestone, for the developer. baseUrl serves them; removable shows delete buttons. %>
<ul class="files-grid">
  <% files.forEach((f, i) => { const image = f.mime.startsWith('image/'); %>
    <li class="file-card">
      <% if (image) { %>
        <a class="file-thumb" href="<%= baseUrl %>/<%= f.id %>" target="_blank" rel="noopener" data-lightbox data-caption="<%= f.name %>">
          <img src="<%= baseUrl %>/<%= f.id %>" alt="<%= f.name %>" loading="lazy">
        </a>
      <% } else { %>
        <span class="file-thumb"><span class="doc-icon" style="width: 48px; height: 58px;"><%= f.mime === 'application/pdf' ? 'PDF' : 'TXT' %></span></span>
      <% } %>
      <span class="file-meta">
        <span class="file-tag"><%= citeTag(i + 1) %></span>
        <span class="file-name" title="<%= f.name %>"><%= f.name %></span>
        <span class="file-size"><%= fmt.bytes(f.size) %></span>
      </span>
      <span class="file-actions">
        <a href="<%= baseUrl %>/<%= f.id %>" <%- image ? 'target="_blank" rel="noopener"' : 'download' %>><%= image ? t('files.open') : t('files.download') %></a>
        <% if (locals.removable) { %>
          <form method="post" action="/milestones/<%= milestoneId %>/files/<%= f.id %>/delete" data-confirm="<%= t('files.delete.confirm', { name: f.name }) %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="link-button danger" type="submit" aria-label="<%= t('files.delete') %> <%= f.name %>"><%= t('files.delete') %></button>
          </form>
        <% } %>
      </span>
    </li>
  <% }) %>
</ul>
