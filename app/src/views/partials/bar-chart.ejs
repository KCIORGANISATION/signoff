<%# A horizontal bar chart drawn in SVG, with the same figures in a table for screen readers.
    include('bar-chart', { title, rows: [{ label, value, display, tone }], header: [label, value], example }) %>
<% const max = Math.max(1, ...rows.map((r) => r.value)); %>
<figure class="chart <%= locals.example ? 'is-example' : '' %>">
  <% if (locals.example) { %><span class="chart-example" aria-hidden="true"><%= t('chart.example') %></span><% } %>
  <div class="chart-rows" aria-hidden="true">
    <% rows.forEach((r, i) => { %>
      <div class="chart-row" style="--i: <%= i %>;">
        <span class="chart-label"><%= r.label %></span>
        <svg class="chart-bar" viewBox="0 0 100 12" preserveAspectRatio="none" focusable="false">
          <rect class="chart-track" x="0" y="0" width="100" height="12"/>
          <% if (r.value > 0) { %><rect class="chart-fill tone-<%= r.tone || 'default' %>" x="0" y="0" width="<%= Math.max(1.5, (r.value / max) * 100).toFixed(2) %>" height="12"/><% } %>
        </svg>
        <span class="chart-value"><%= r.display ?? r.value %></span>
      </div>
    <% }) %>
  </div>
  <div class="sr-only"><table>
    <caption><%= title %><% if (locals.example) { %> (<%= t('chart.example') %>)<% } %></caption>
    <thead><tr><th scope="col"><%= header[0] %></th><th scope="col"><%= header[1] %></th></tr></thead>
    <tbody>
      <% rows.forEach((r) => { %><tr><th scope="row"><%= r.label %></th><td><%= r.display ?? r.value %></td></tr><% }) %>
    </tbody>
  </table></div>
</figure>
