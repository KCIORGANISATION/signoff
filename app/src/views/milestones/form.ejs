<%- include('../partials/head', { title: milestone ? t('milestone.edit') : t('milestone.new') }) %>
<div class="container" style="max-width: 640px;">
  <a class="back" href="<%= milestone ? `/milestones/${milestone.id}` : `/projects/${project.id}` %>">← <%= t('common.back') %></a>
  <div class="card">
    <h1 style="font-size: 24px; margin-bottom: 4px;"><%= milestone ? t('milestone.edit') : t('milestone.new') %></h1>
    <p class="muted small" style="margin-bottom: 20px;"><%= project.name %></p>
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="<%= milestone ? `/milestones/${milestone.id}` : `/projects/${project.id}/milestones` %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="title"><%= t('milestone.title') %></label>
        <input id="title" name="title" type="text" required value="<%= values.title ?? '' %>">
      </div>
      <div class="field">
        <label for="description"><%= t('milestone.description') %></label>
        <textarea id="description" name="description"><%= values.description ?? '' %></textarea>
      </div>
      <div class="field" style="max-width: 240px;">
        <label for="amount"><%= t('milestone.amount') %> (<%= project.currency %>)</label>
        <input id="amount" name="amount" type="text" inputmode="decimal" placeholder="1500" value="<%= values.amount ?? '' %>">
        <p class="hint"><%= t('milestone.amount.hint') %></p>
      </div>
      <fieldset class="fieldset">
        <legend><%= t('milestone.payment') %></legend>
        <p class="hint" style="margin: 0 0 14px;"><%= t('milestone.payment.hint') %></p>
        <div class="field">
          <label for="payment_link"><%= t('milestone.paymentLink') %></label>
          <input id="payment_link" name="payment_link" type="url" maxlength="500" placeholder="https://buy.stripe.com/…" aria-describedby="payment_link-hint" value="<%= values.payment_link ?? '' %>">
          <p class="hint" id="payment_link-hint"><%= t('milestone.paymentLink.hint') %></p>
        </div>
        <div class="field">
          <label for="payment_note"><%= t('milestone.paymentNote') %></label>
          <textarea id="payment_note" name="payment_note" maxlength="500" rows="3" aria-describedby="payment_note-hint" placeholder="<%= t('milestone.paymentNote.placeholder') %>"><%= values.payment_note ?? '' %></textarea>
          <p class="hint" id="payment_note-hint"><%= t('milestone.paymentNote.hint') %></p>
        </div>
      </fieldset>
      <div class="form-actions">
        <button class="btn" type="submit"><%= t('milestone.save') %></button>
        <a class="btn btn-ghost" href="<%= milestone ? `/milestones/${milestone.id}` : `/projects/${project.id}` %>"><%= t('common.cancel') %></a>
      </div>
    </form>
  </div>
  <% if (milestone) { %>
    <form method="post" action="/milestones/<%= milestone.id %>/delete" data-confirm="<%= t('milestone.delete.confirm') %>" style="margin-top: 20px;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-danger btn-small" type="submit"><%= t('milestone.delete') %></button>
    </form>
  <% } %>
</div>
<%- include('../partials/foot') %>
