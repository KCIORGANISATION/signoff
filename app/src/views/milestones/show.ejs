<%- include('../partials/head', { title: milestone.title, crumbs: [{ label: t('nav.projects'), href: '/projects' }, { label: milestone.project_name, href: `/projects/${milestone.project_id}` }, { label: milestone.title }] }) %>
<div class="page-title reveal">
  <div style="min-width: 0;">
    <div class="row">
      <h1 style="overflow-wrap: anywhere;"><%= milestone.title %></h1>
      <%- include('../partials/badge', { status: milestone.status }) %>
    </div>
    <p><%= milestone.client_name %><% if (milestone.amount !== null) { %> · <%= fmt.money(milestone.amount, milestone.currency) %><% } %></p>
    <ul class="milestone-facts">
      <% if (revisions.limited) { %>
        <li class="<%= revisions.used > revisions.limit ? 'is-beyond' : '' %>"><%= revisions.used === 0 ? t('revisions.none', { limit: revisions.limit }) : revisions.used > revisions.limit ? t('revisions.beyond', { used: revisions.used, limit: revisions.limit }) : t('revisions.count', { used: revisions.used, limit: revisions.limit }) %></li>
      <% } %>
      <% if (overdue) { %>
        <li class="is-overdue"><%- include('../partials/icon', { name: 'clock', cls: 'icon-sm' }) %><%= t('deadline.dev.passed', { date: fmt.date(milestone.due_at) }) %></li>
      <% } else if (milestone.due_at && (milestone.status === 'sent' || milestone.status === 'viewed')) { %>
        <li><%- include('../partials/icon', { name: 'clock', cls: 'icon-sm' }) %><%= t('deadline.dev.due', { date: fmt.date(milestone.due_at) }) %></li>
      <% } %>
    </ul>
  </div>
  <div class="row">
    <a class="btn" href="/milestones/<%= milestone.id %>/preview"><%- include('../partials/icon', { name: 'eye' }) %><%= t('milestone.form.preview') %></a>
    <% if (!projectClosed) { %><a class="btn" href="/milestones/<%= milestone.id %>/edit"><%- include('../partials/icon', { name: 'pencil' }) %><%= locked ? t('milestone.payment.edit') : t('common.edit') %></a><% } %>
  </div>
</div>

<div class="split">
  <div class="stack">
    <% if (projectClosed) { %>
      <div class="locked-banner is-closed reveal" role="status">
        <p><%- include('../partials/icon', { name: 'lock' }) %><span><%= t(`milestone.projectClosed.${milestone.project_status}`) %></span></p>
        <a class="btn btn-light btn-small" href="/projects/<%= milestone.project_id %>"><%- include('../partials/icon', { name: 'arrowLeft', cls: 'icon-sm' }) %><%= t('milestone.backToProject') %></a>
      </div>
    <% } else if (locked) { %>
      <div class="locked-banner reveal" role="status">
        <p><%- include('../partials/icon', { name: 'lock' }) %><span><%= t('milestone.locked') %></span></p>
        <form method="post" action="/milestones/<%= milestone.id %>/follow-up">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-light btn-small" type="submit"><%- include('../partials/icon', { name: 'plus', cls: 'icon-sm' }) %><%= t('milestone.followUp') %></button>
        </form>
      </div>
    <% } %>

    <% if (editedAfterApproval) { %><%- include('../partials/alert', { kind: 'info', text: t('milestone.editedAfterApproval') }) %><% } %>

    <section class="glass panel reveal" style="--i: 1;" aria-labelledby="desc-title">
      <h2 id="desc-title"><%= t('review.description') %></h2>
      <% if (milestone.description) { %>
        <%- include('../partials/description', { text: milestone.description }) %>
      <% } else { %>
        <p class="empty"><%= t('review.description.empty') %></p>
      <% } %>
    </section>

    <section class="glass panel reveal" style="--i: 2;" id="files" aria-labelledby="files-title">
      <h2 id="files-title"><%= t('files.title') %></h2>
      <%- include('../partials/upload', { milestone, files, filesEnabled, locked: locked || projectClosed, frozen: locked, quota }) %>
    </section>

    <section class="glass panel reveal" style="--i: 3;" id="deliverables" aria-labelledby="deliverables-title">
      <h2 id="deliverables-title"><%= t('milestone.deliverables') %></h2>
      <% if (deliverables.length === 0) { %>
        <p class="empty"><%= locked || projectClosed ? t('milestone.deliverables.none') : t('milestone.deliverables.empty') %></p>
      <% } else { %>
        <div><%- include('../partials/deliverables', { deliverables, removable: !locked && !projectClosed, milestoneId: milestone.id }) %></div>
      <% } %>

      <% if (!locked && !projectClosed) { %>
      <div>
        <% const urlError = formError && formError.kind === 'url' ? formError : null; %>
        <details class="add" <%= urlError ? 'open' : '' %>>
          <summary><%- include('../partials/icon', { name: 'link', cls: 'icon-sm' }) %><%= t('milestone.addUrl') %></summary>
          <form method="post" action="/milestones/<%= milestone.id %>/deliverables">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (urlError) { %><%- include('../partials/alert', { kind: 'error', text: urlError.message }) %><% } %>
            <input type="hidden" name="kind" value="url">
            <div class="fields-row" style="margin-top: 4px;">
              <div class="field">
                <label for="url"><%= t('milestone.url') %></label>
                <input id="url" name="url" type="url" required placeholder="https://staging.example.com" value="<%= urlError ? urlError.url : '' %>">
              </div>
              <div class="field">
                <label for="url-label"><%= t('milestone.label') %></label>
                <input id="url-label" name="label" type="text" placeholder="<%= t('milestone.label.placeholder') %>" value="<%= urlError ? urlError.label : '' %>">
              </div>
            </div>
            <div class="form-actions"><button class="btn btn-small" type="submit"><%= t('milestone.add') %></button></div>
          </form>
        </details>

        <% const noteError = formError && formError.kind === 'note' ? formError : null; %>
        <details class="add" <%= noteError ? 'open' : '' %>>
          <summary><%- include('../partials/icon', { name: 'file', cls: 'icon-sm' }) %><%= t('milestone.addNote') %></summary>
          <form method="post" action="/milestones/<%= milestone.id %>/deliverables">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (noteError) { %><%- include('../partials/alert', { kind: 'error', text: noteError.message }) %><% } %>
            <input type="hidden" name="kind" value="note">
            <div class="field">
              <label for="note-label"><%= t('milestone.label') %></label>
              <input id="note-label" name="label" type="text" value="<%= noteError ? noteError.label : '' %>">
            </div>
            <div class="field">
              <label for="note-body"><%= t('milestone.note') %></label>
              <textarea id="note-body" name="body" required><%= noteError ? noteError.body : '' %></textarea>
            </div>
            <div class="form-actions"><button class="btn btn-small" type="submit"><%= t('milestone.add') %></button></div>
          </form>
        </details>
      </div>
      <% } %>
    </section>
  </div>

  <aside class="split-side">
    <section class="glass panel panel-tight reveal" style="--i: 1;" id="share" aria-labelledby="share-title">
      <h2 id="share-title"><%= t('milestone.share') %></h2>
      <% if (milestone.status === 'not_done' || milestone.status === 'cancelled') { %>
        <p class="muted small"><%= t(`milestone.share.${milestone.status}`) %></p>
      <% } else if (milestone.status === 'draft') { %>
        <p class="muted small"><%= t('milestone.share.draft', { email: milestone.client_email }) %></p>
        <form method="post" action="/milestones/<%= milestone.id %>/send">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-primary btn-large btn-block" type="submit" data-loading><%- include('../partials/icon', { name: 'send' }) %><%= t('milestone.share.button') %></button>
        </form>
      <% } else { %>
        <% if (milestone.status === 'feedback') { %><p class="muted small"><%= t('milestone.share.againHint', { email: milestone.client_email }) %></p><% } %>
        <% if (expired) { %>
          <p class="muted small"><%= t('milestone.share.expired', { date: fmt.date(milestone.expires_at) }) %></p>
        <% } else { %>
          <div class="share-link">
            <input id="share-url" type="text" readonly value="<%= link %>" aria-label="<%= t('milestone.share') %>">
            <button class="btn" type="button" data-copy="#share-url" data-copied-label="<%= t('milestone.share.copied') %>"><%- include('../partials/icon', { name: 'copy', cls: 'icon-sm' }) %><%= t('milestone.share.copy') %></button>
          </div>
          <% if (milestone.expires_at) { %><p class="hint" style="margin: 0;"><%= t('milestone.share.expires', { date: fmt.date(milestone.expires_at) }) %></p><% } %>
        <% } %>
        <% if (milestone.status === 'sent' || milestone.status === 'viewed') { %>
          <% if (canRemind) { %>
            <form method="post" action="/milestones/<%= milestone.id %>/remind">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-block" type="submit" data-loading><%- include('../partials/icon', { name: 'send' }) %><%= t('next.remind.action') %></button>
            </form>
          <% } else if (!projectClosed) { %>
            <p class="hint" style="margin: 0;"><%= t('next.remind.recent') %></p>
          <% } %>
        <% } %>
        <% if (milestone.status === 'feedback') { %>
          <form method="post" action="/milestones/<%= milestone.id %>/send">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-primary btn-large btn-block" type="submit" data-loading><%- include('../partials/icon', { name: 'send' }) %><%= t('milestone.share.again') %></button>
          </form>
        <% } %>
      <% } %>
      <% if (approval) { %>
        <a class="btn btn-block" href="/milestones/<%= milestone.id %>/certificate"><%- include('../partials/icon', { name: 'shield' }) %><%= t('milestone.certificate') %></a>
      <% } %>
    </section>

    <% if (milestone.payment_link || milestone.payment_note) { %>
      <section class="glass panel panel-tight reveal" style="--i: 2;" id="payment" aria-labelledby="payment-title">
        <h2 id="payment-title"><%= t('milestone.payment') %></h2>
        <% if (milestone.payment_link) { %>
          <p><a class="url" href="<%= milestone.payment_link %>" target="_blank" rel="noopener noreferrer" style="overflow-wrap: anywhere;"><%= milestone.payment_link %></a></p>
        <% } %>
        <% if (milestone.payment_note) { %><p class="payment-note"><%= milestone.payment_note %></p><% } %>
        <p class="hint" style="margin: 0;"><%= t('milestone.payment.hint') %></p>
      </section>
    <% } %>

    <section class="glass panel panel-tight reveal" style="--i: 3;" aria-labelledby="history-title">
      <h2 id="history-title"><%= t('milestone.history') %></h2>
      <% if (events.length === 0) { %>
        <p class="empty"><%= t('milestone.history.empty') %></p>
      <% } else { %>
        <ul class="timeline">
          <% events.forEach((e) => { const snap = typeof e.snapshot === 'string' ? JSON.parse(e.snapshot) : e.snapshot; %>
            <li class="t-<%= e.type %>" <%- e.type === 'feedback' ? `id="feedback-${e.id}"` : '' %>>
              <strong><%= t('event.' + e.type) %></strong>
              <% if (e.type === 'approved' && e.client_name) { %> · <%= e.client_name %><% } %>
              <% if (e.type === 'feedback' && e.round) { %> · <%= e.round_limit === null ? t('revisions.round', { round: e.round }) : t('revisions.roundOf', { round: e.round, limit: e.round_limit }) %><% } %>
              <% if (e.type.startsWith('supplement_') && snap) { %> · <%= snap.title %> · <%= fmt.money(snap.amount, snap.currency) %><% } %>
              <span class="meta"><%= fmt.dateTime(e.created_at) %></span>
              <% if (e.html) { %>
                <div class="message"><%- e.html %></div>
              <% } else if (e.message) { %>
                <div class="message"><%= e.message %></div>
              <% } %>
              <% if (e.type === 'feedback') { const d = decisions.byFeedback.get(e.id) ?? { outOfScope: null, acceptedAnyway: null, supplements: [] }; %>
                <div class="feedback-scope">
                  <% if (e.over_limit) { %><span class="scope-tag is-beyond"><%= t('revisions.beyondTag') %></span><% } %>
                  <% if (d.outOfScope) { %><span class="scope-tag"><%= t('scope.tag') %></span><% } %>
                  <% if (d.acceptedAnyway) { %><span class="scope-tag is-ok"><%= t('revisions.acceptedTag') %></span><% } %>
                  <% d.supplements.forEach((sup) => { %><span class="scope-tag is-<%= sup.status %>"><%= t(`supplement.status.${sup.status}`) %> · <%= fmt.money(sup.amount, sup.currency) %></span><% }) %>
                </div>
                <% if (!projectClosed) { %>
                  <div class="feedback-actions">
                    <% if (e.over_limit && !d.acceptedAnyway && d.supplements.length === 0) { %>
                      <p class="small"><%= t('revisions.beyondHint') %></p>
                      <form method="post" action="/milestones/<%= milestone.id %>/feedback/<%= e.id %>/accept">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-small" type="submit"><%= t('revisions.acceptAnyway') %></button>
                      </form>
                    <% } %>
                    <% if (!d.outOfScope && !d.acceptedAnyway && !e.over_limit) { %>
                      <form method="post" action="/milestones/<%= milestone.id %>/feedback/<%= e.id %>/out-of-scope" data-confirm="<%= t('scope.mark.confirm') %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn-small" type="submit"><%= t('scope.mark') %></button>
                      </form>
                    <% } %>
                    <% if (canPropose && (d.outOfScope || (e.over_limit && !d.acceptedAnyway)) && !d.supplements.some((sup) => sup.status !== 'declined')) { %>
                      <a class="btn btn-small btn-light" href="/milestones/<%= milestone.id %>/supplements/new?feedback=<%= e.id %>"><%- include('../partials/icon', { name: 'plus', cls: 'icon-sm' }) %><%= t('supplement.propose') %></a>
                    <% } %>
                  </div>
                <% } %>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </aside>
</div>
<%- include('../partials/foot') %>
