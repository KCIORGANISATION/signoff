<%- include('../partials/head', { title: milestone.title }) %>
<div class="container">
  <a class="back" href="/projects/<%= milestone.project_id %>">← <%= milestone.project_name %></a>
  <div class="page-header">
    <div>
      <div class="row">
        <h1><%= milestone.title %></h1>
        <%- include('../partials/badge', { status: milestone.status }) %>
      </div>
      <p class="muted">
        <%= milestone.client_name %><% if (milestone.amount !== null) { %> · <%= fmt.money(milestone.amount, milestone.currency) %><% } %>
      </p>
    </div>
    <a class="btn btn-ghost btn-small" href="/milestones/<%= milestone.id %>/edit"><%= t('common.edit') %></a>
  </div>

  <% if (editedAfterApproval) { %>
    <div class="alert alert-info"><%= t('milestone.editedAfterApproval') %></div>
  <% } %>

  <% if (milestone.description) { %>
    <section class="card"><p style="white-space: pre-wrap;"><%= milestone.description %></p></section>
  <% } %>

  <section class="card" id="share">
    <div class="card-header">
      <h2><%= t('milestone.share') %></h2>
      <% if (approval) { %><a class="btn btn-small" href="/milestones/<%= milestone.id %>/certificate"><%= t('milestone.certificate') %></a><% } %>
    </div>
    <% if (milestone.status === 'draft') { %>
      <p class="muted"><%= t('milestone.share.draft') %></p>
      <form method="post" action="/milestones/<%= milestone.id %>/send" style="margin-top: 14px;">
        <button class="btn" type="submit"><%= t('milestone.share.button') %></button>
      </form>
    <% } else { %>
      <% if (milestone.status === 'feedback') { %>
        <p class="muted"><%= t('milestone.share.againHint') %></p>
      <% } %>
      <% if (expired) { %>
        <p class="muted"><%= t('milestone.share.expired', { date: fmt.date(milestone.expires_at) }) %></p>
      <% } else { %>
        <div class="share-link">
          <input id="share-url" type="text" readonly value="<%= link %>" aria-label="<%= t('milestone.share') %>">
          <button class="btn btn-ghost" type="button" data-copy="#share-url" data-copied-label="<%= t('milestone.share.copied') %>"><%= t('milestone.share.copy') %></button>
        </div>
        <% if (milestone.expires_at) { %>
          <p class="hint"><%= t('milestone.share.expires', { date: fmt.date(milestone.expires_at) }) %></p>
        <% } %>
      <% } %>
      <% if (milestone.status === 'feedback') { %>
        <form method="post" action="/milestones/<%= milestone.id %>/send" style="margin-top: 14px;">
          <button class="btn" type="submit"><%= t('milestone.share.again') %></button>
        </form>
      <% } %>
    <% } %>
  </section>

  <section class="card" id="deliverables">
    <div class="card-header"><h2><%= t('milestone.deliverables') %></h2></div>
    <% if (deliverables.length === 0) { %>
      <p class="empty"><%= t('milestone.deliverables.empty') %></p>
    <% } else { %>
      <%- include('../partials/deliverables', { deliverables, removable: true, milestoneId: milestone.id }) %>
    <% } %>

    <% const urlError = formError && formError.kind === 'url' ? formError : null; %>
    <details class="add" <%= urlError ? 'open' : '' %>>
      <summary>+ <%= t('milestone.addUrl') %></summary>
      <form method="post" action="/milestones/<%= milestone.id %>/deliverables">
        <% if (urlError) { %><div class="alert alert-error" role="alert"><%= urlError.message %></div><% } %>
        <input type="hidden" name="kind" value="url">
        <div class="two-cols">
          <div>
            <label for="url"><%= t('milestone.url') %></label>
            <input id="url" name="url" type="url" required placeholder="https://staging.example.com" value="<%= urlError ? urlError.url : '' %>">
          </div>
          <div>
            <label for="url-label"><%= t('milestone.label') %></label>
            <input id="url-label" name="label" type="text" placeholder="<%= t('milestone.label.placeholder') %>" value="<%= urlError ? urlError.label : '' %>">
          </div>
        </div>
        <div class="form-actions"><button class="btn btn-small" type="submit"><%= t('milestone.add') %></button></div>
      </form>
    </details>

    <% const noteError = formError && formError.kind === 'note' ? formError : null; %>
    <details class="add" <%= noteError ? 'open' : '' %>>
      <summary>+ <%= t('milestone.addNote') %></summary>
      <form method="post" action="/milestones/<%= milestone.id %>/deliverables">
        <% if (noteError) { %><div class="alert alert-error" role="alert"><%= noteError.message %></div><% } %>
        <input type="hidden" name="kind" value="note">
        <div class="field">
          <label for="note-label"><%= t('milestone.label') %></label>
          <input id="note-label" name="label" type="text" value="<%= noteError ? noteError.label : '' %>">
        </div>
        <div class="field">
          <label for="note-body"><%= t('milestone.note') %></label>
          <textarea id="note-body" name="body" required><%= noteError ? noteError.body : '' %></textarea>
        </div>
        <div class="form-actions"><button class="btn btn-small" type="submit"><%= t('milestone.add') %></button></div>
      </form>
    </details>
  </section>

  <section class="card">
    <div class="card-header"><h2><%= t('milestone.history') %></h2></div>
    <% if (events.length === 0) { %>
      <p class="empty"><%= t('milestone.history.empty') %></p>
    <% } else { %>
      <ul class="timeline">
        <% events.forEach((e) => { %>
          <li>
            <strong><%= t('event.' + e.type) %></strong>
            <span class="meta"> · <%= fmt.dateTime(e.created_at) %></span>
            <% if (e.message) { %><div class="message"><%= e.message %></div><% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>
<%- include('../partials/foot') %>
