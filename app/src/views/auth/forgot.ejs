<%- include('../partials/head', { title: t('forgot.title') }) %>
<div class="auth">
  <section class="glass auth-card reveal">
    <h1><%= t('forgot.title') %></h1>
    <% if (sent) { %>
      <div style="margin-top: 16px;"><%- include('../partials/alert', { kind: 'success', text: t('forgot.sent') }) %></div>
    <% } else { %>
      <p class="lead"><%= t('forgot.intro') %></p>
      <% if (error) { %><%- include('../partials/alert', { kind: 'error', text: error }) %><% } %>
      <form method="post" action="/forgot" style="margin-top: 16px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="email"><%= t('auth.email') %></label>
          <input id="email" name="email" type="email" autocomplete="email" required value="<%= values.email ?? '' %>">
        </div>
        <div class="form-actions"><button class="btn btn-light btn-large btn-block" type="submit" data-loading><%= t('forgot.submit') %></button></div>
      </form>
    <% } %>
    <p class="auth-switch"><a href="/login"><%= t('forgot.back') %></a></p>
  </section>
</div>
<%- include('../partials/foot', { centered: true }) %>
