<%- include('../partials/head', { title: t('nav.signup') }) %>
<div class="auth">
  <section class="glass auth-card reveal">
    <h1><%= t('auth.signup.title') %></h1>
    <p class="lead"><%= t('app.tagline') %></p>
    <% if (error) { %><%- include('../partials/alert', { kind: 'error', text: error }) %><% } %>
    <form method="post" action="/signup" style="margin-top: 16px;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (inviteRequired) { %>
        <div class="field">
          <label for="invite_code"><%= t('auth.invite') %></label>
          <input id="invite_code" name="invite_code" type="text" autocomplete="off" required aria-describedby="invite_code-hint">
          <p class="hint" id="invite_code-hint" style="margin-top: 2px;"><%= t('auth.invite.hint') %></p>
        </div>
      <% } %>
      <div class="fields-row" style="margin-top: 16px;">
        <div class="field">
          <label for="first_name"><%= t('profile.firstName') %></label>
          <input id="first_name" name="first_name" type="text" autocomplete="given-name" required maxlength="80" value="<%= values.first_name ?? '' %>">
        </div>
        <div class="field">
          <label for="last_name"><%= t('profile.lastName') %></label>
          <input id="last_name" name="last_name" type="text" autocomplete="family-name" required maxlength="80" value="<%= values.last_name ?? '' %>">
        </div>
      </div>
      <div class="field">
        <label for="name"><%= t('profile.business') %></label>
        <input id="name" name="name" type="text" autocomplete="organization" maxlength="120" value="<%= values.name ?? '' %>" aria-describedby="name-hint">
        <p class="hint" id="name-hint" style="margin-top: 2px;"><%= t('profile.business.hint') %></p>
      </div>
      <div class="field">
        <label for="email"><%= t('auth.email') %></label>
        <input id="email" name="email" type="email" autocomplete="email" required value="<%= values.email ?? '' %>">
      </div>
      <div class="field">
        <label for="password"><%= t('auth.password') %></label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required aria-describedby="password-hint">
        <p class="hint" id="password-hint" style="margin-top: 2px;"><%= t('auth.password.hint') %></p>
      </div>
      <% if (betaRules) { %>
        <label class="check beta-check">
          <input type="checkbox" name="beta_rules" value="yes" required>
          <span><%= t('beta.accept.label') %></span>
        </label>
        <p class="hint beta-check-link"><a href="/beta" target="_blank" rel="noopener"><%= t('beta.accept.read') %><span class="sr-only"> <%= t('review.newTab') %></span></a></p>
      <% } %>
      <div class="form-actions"><button class="btn btn-light btn-large btn-block" type="submit" data-loading><%= t('auth.signup.submit') %></button></div>
    </form>
    <p class="auth-switch muted"><%= t('auth.signup.switch') %> <a href="/login"><%= t('nav.login') %></a></p>
  </section>
</div>
<%- include('../partials/foot', { centered: true }) %>
