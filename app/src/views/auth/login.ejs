<%- include('../partials/head', { title: t('nav.login') }) %>
<div class="auth">
  <section class="glass auth-card reveal">
    <h1><%= t('auth.login.title') %></h1>
    <p class="lead"><%= t('app.tagline') %></p>
    <% if (error) { %><%- include('../partials/alert', { kind: 'error', text: error }) %><% } %>
    <form method="post" action="/login" style="margin-top: 16px;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="email"><%= t('auth.email') %></label>
        <input id="email" name="email" type="email" autocomplete="email" required value="<%= values.email ?? '' %>">
      </div>
      <div class="field">
        <label for="password"><%= t('auth.password') %></label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
        <p class="hint" style="margin-top: 2px;"><a href="/forgot"><%= t('auth.forgot') %></a></p>
      </div>
      <div class="form-actions"><button class="btn btn-light btn-large btn-block" type="submit" data-loading><%= t('auth.login.submit') %></button></div>
    </form>
    <p class="auth-switch muted"><%= t('auth.login.switch') %> <a href="/signup"><%= t('nav.signup') %></a></p>
  </section>
</div>
<%- include('../partials/foot', { centered: true }) %>
