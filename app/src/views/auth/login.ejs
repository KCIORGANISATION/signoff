<%- include('../partials/head', { title: t('nav.login') }) %>
<div class="container narrow">
  <div class="card">
    <h1 style="font-size: 24px; margin-bottom: 20px;"><%= t('auth.login.title') %></h1>
    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/login">
      <div class="field">
        <label for="email"><%= t('auth.email') %></label>
        <input id="email" name="email" type="email" autocomplete="email" required value="<%= values.email ?? '' %>">
      </div>
      <div class="field">
        <label for="password"><%= t('auth.password') %></label>
        <input id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <div class="form-actions"><button class="btn" type="submit" style="width: 100%;"><%= t('auth.login.submit') %></button></div>
    </form>
  </div>
  <p class="muted small" style="text-align: center; margin-top: 16px;"><%= t('auth.login.switch') %> <a href="/signup"><%= t('nav.signup') %></a></p>
</div>
<%- include('../partials/foot') %>
