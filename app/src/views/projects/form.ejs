<%- include('../partials/head', { title: project ? t('project.edit') : t('project.new'), crumbs: project ? [{ label: t('nav.projects'), href: '/dashboard' }, { label: project.name, href: `/projects/${project.id}` }, { label: t('project.edit') }] : [{ label: t('nav.projects'), href: '/dashboard' }, { label: t('project.new') }] }) %>
<div class="page-medium" style="margin: 0 auto;">
  <section class="glass panel reveal">
    <h1 style="font-size: 28px;"><%= project ? t('project.edit') : t('project.new') %></h1>
    <% if (error) { %><%- include('../partials/alert', { kind: 'error', text: error }) %><% } %>
    <form method="post" action="<%= project ? `/projects/${project.id}` : '/projects' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="name"><%= t('project.name') %></label>
        <input id="name" name="name" type="text" required value="<%= values.name ?? '' %>">
      </div>
      <div class="fields-row" style="margin-top: 16px;">
        <div class="field">
          <label for="client_name"><%= t('project.clientName') %></label>
          <input id="client_name" name="client_name" type="text" required value="<%= values.client_name ?? '' %>">
        </div>
        <div class="field">
          <label for="client_email"><%= t('project.clientEmail') %></label>
          <input id="client_email" name="client_email" type="email" required value="<%= values.client_email ?? '' %>">
        </div>
      </div>
      <div class="field" style="max-width: 220px; margin-top: 16px;">
        <label for="currency"><%= t('project.currency') %></label>
        <select id="currency" name="currency">
          <% currencies.forEach((c) => { %><option value="<%= c %>" <%= values.currency === c ? 'selected' : '' %>><%= c %></option><% }) %>
        </select>
      </div>
      <div class="form-actions">
        <button class="btn btn-light" type="submit" data-loading><%= t('project.save') %></button>
        <a class="btn" href="<%= project ? `/projects/${project.id}` : '/dashboard' %>"><%= t('common.cancel') %></a>
      </div>
    </form>
  </section>
  <% if (project) { %>
    <form method="post" action="/projects/<%= project.id %>/delete" data-confirm="<%= t('project.delete.confirm') %>" style="margin-top: 20px;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-danger btn-small" type="submit"><%- include('../partials/icon', { name: 'trash', cls: 'icon-sm' }) %><%= t('project.delete') %></button>
    </form>
  <% } %>
</div>
<%- include('../partials/foot') %>
