<%- include('../partials/head', { title: project.name, crumbs: [{ label: t('nav.projects'), href: '/dashboard' }, { label: project.name }] }) %>
<div class="page-title reveal">
  <div>
    <h1><%= project.name %></h1>
    <p><%= t('project.client') %> : <%= project.client_name %> · <a href="mailto:<%= project.client_email %>"><%= project.client_email %></a> · <%= project.currency %></p>
  </div>
  <div class="row">
    <a class="btn" href="/projects/<%= project.id %>/edit"><%- include('../partials/icon', { name: 'pencil' }) %><%= t('common.edit') %></a>
    <a class="btn btn-light" href="/projects/<%= project.id %>/milestones/new"><%- include('../partials/icon', { name: 'plus' }) %><%= t('milestone.new') %></a>
  </div>
</div>

<section class="glass panel reveal" style="--i: 1;" aria-labelledby="milestones-title">
  <div class="panel-head"><h2 id="milestones-title"><%= t('project.milestones') %></h2></div>
  <% if (milestones.length === 0) { %>
    <div class="empty-state">
      <span class="empty-icon"><%- include('../partials/icon', { name: 'file', cls: 'icon-lg' }) %></span>
      <h3><%= t('project.milestones.empty') %></h3>
      <p><%= t('project.milestones.emptyHint') %></p>
      <a class="btn btn-light" href="/projects/<%= project.id %>/milestones/new"><%- include('../partials/icon', { name: 'plus' }) %><%= t('milestone.new') %></a>
    </div>
  <% } else { %>
    <ol class="rows">
      <% milestones.forEach((m, i) => { %>
        <li>
          <a class="row-link" href="/milestones/<%= m.id %>">
            <span class="row-main">
              <span class="row-meta"><%= t('welcome.position', { position: i + 1, total: milestones.length }) %></span>
              <span class="row-title"><%= m.title %></span>
              <% if (m.amount !== null) { %><span class="row-meta"><%= fmt.money(m.amount, project.currency) %></span><% } %>
            </span>
            <span class="row-end"><%- include('../partials/badge', { status: m.status }) %><span class="chev"><%- include('../partials/icon', { name: 'chevronRight' }) %></span></span>
          </a>
        </li>
      <% }) %>
    </ol>
  <% } %>
</section>
<%- include('../partials/foot') %>
