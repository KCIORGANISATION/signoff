<% const onClientLink = (locals.currentPath || '').startsWith('/r/'); %>
<%- include('partials/head', { title: '', client: onClientLink }) %>
<div class="auth">
  <section class="glass error-card reveal">
    <span class="empty-icon"><%- include('partials/icon', { name: locals.icon || 'search', cls: 'icon-lg' }) %></span>
    <p><%= message %></p>
    <% if (!onClientLink) { %><a class="btn" href="/"><%- include('partials/icon', { name: 'arrowLeft' }) %><%= t('common.back') %></a><% } %>
  </section>
</div>
<%- include('partials/foot', { centered: !onClientLink, client: onClientLink }) %>
