# Copy this file to .env and fill in the values.

# Port for the local server.
PORT=3000

# Public URL of the app, used to build client review links.
APP_URL=http://localhost:3000

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Where the "Powered by Signoff" link on client pages points (the landing page).
LANDING_URL=

# Leave empty to use the built-in local database (stored in ./data).
# Set it to a Postgres connection string (e.g. Neon) to use a real server.
DATABASE_URL=

# Optional: Resend API key and sender, to email you when a client approves or leaves feedback.
# Without them, notifications are printed in the terminal.
RESEND_API_KEY=
EMAIL_FROM=
