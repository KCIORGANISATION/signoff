# Copy this file to .env for local development and fill in the values.
# In production (Render), set the same variables in the service's Environment tab.
# Never commit real values.

# "development" on your computer, "production" on Render.
# In production the app refuses to start if SESSION_SECRET, APP_URL,
# DATABASE_URL or INVITE_CODE is missing, and cookies are sent over HTTPS only.
NODE_ENV=development

# Port for the local server. Render sets it automatically.
PORT=3000

# Public URL of the app, without a trailing slash (e.g. https://app.signoff.example).
# Used in client review links and in emails. Required in production.
APP_URL=http://localhost:3000

# Long random string used to sign session cookies (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Locally, a temporary one is used if empty.
SESSION_SECRET=

# Postgres connection string (Neon), e.g.
# postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Leave empty locally to use the built-in database stored in ./data.
# Tables are created automatically on first start. Required in production.
DATABASE_URL=

# Link to the landing page, used by "Powered by Signoff" on client pages.
LANDING_URL=

# Resend API key (resend.com > API Keys). Without it, emails are printed in the terminal.
RESEND_API_KEY=

# Sender of the emails, on a domain verified in Resend, e.g. Signoff <hello@signoff.example>.
# Required when RESEND_API_KEY is set.
EMAIL_FROM=

# Code people must type to create an account (private beta).
# Empty locally means anyone can sign up. Required in production.
INVITE_CODE=

# Optional: number of reverse proxies in front of the app, so the real client IP
# is recorded in approval proofs. Defaults to 1 in production (Render), 0 locally.
# TRUST_PROXY=1

# Backups (npm run backup / npm run restore). In production these live in GitHub secrets.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Test database that npm run restore writes into. Never the production database.
RESTORE_DATABASE_URL=
